# development | production
APP_ENV=development

# Obrigatória quando APP_ENV=production.
SECRET_KEY=

# Ative somente quando a aplicação estiver servida exclusivamente via HTTPS.
SESSION_COOKIE_SECURE=0

# Opcional. Se vazio, usa database.db na raiz do projeto.
DATABASE_PATH=

# Desenvolvimento local apenas.
FLASK_DEBUG=0
